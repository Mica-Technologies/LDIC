{
  "_comment": "LDIC built-in theme 'horizon': a modern, left-aligned menu over a slow panorama, with staggered entrance animations. Override 'title' (or set pack.name in config/ldic/settings.json) for your pack's name.",
  "ldic": 1,
  "forge_update_notice": false,
  "name": "Horizon",
  "author": "Mica Technologies",
  "description": "Left-aligned menu with an accent bar, slow cinematic panorama, clock and pack title.",
  "design": { "mode": "height", "height": 400, "min": 0.5 },
  "fonts": { "ui": "sans", "ui_bold": "sans:bold" },
  "constants": {
    "accent": "#4FC3F7",
    "hud_background": "#A00C1218",
    "hud_text": "#E8ECF0",
    "hud_accent": "accent",
    "menu_x": 48,
    "menu_y": 86,
    "row": 30
  },
  "functions": {
    "enter(number i)": "ease_out_cubic(saturate((screen_time - 0.06 * i) / 0.45))",
    "slide(number i)": "-24 * (1 - enter(i))"
  },
  "screens": {
    "main": {
      "elements": [
        { "id": "panorama", "type": "panorama", "speed": 0.8, "pitch": "12 + 6 * sin(time * 3)", "fov": 75 },
        { "id": "shade_left", "type": "rect", "gradient": "horizontal", "width": "62%", "colour": "#E00A0E14", "colour_bottom": "#000A0E14" },
        { "id": "shade_bottom", "type": "rect", "anchor": "bottom", "height": "35%", "colour": "#00000000", "colour_bottom": "#B0000000" },

        { "id": "menu", "type": "group", "anchor": "left", "width": 300, "height": 290, "children": [
        { "id": "title", "type": "text", "font": "ui_bold", "size": 34, "colour": "#FFFFFF", "shadow": false,
          "text": "{is_empty(pack_name) ? 'Minecraft' : pack_name}",
          "x": "menu_x + slide(0)", "y": 0, "opacity": "enter(0)" },
        { "id": "subtitle", "type": "text", "font": "ui", "size": 11, "colour": "#B0FFFFFF", "shadow": false,
          "text": "{is_empty(pack_version) ? 'Minecraft ' + mc_version : 'Version ' + pack_version}  ·  {mod_count} mods",
          "x": "menu_x + slide(1)", "y": 40, "opacity": "enter(1)" },
        { "id": "title_rule", "type": "rect", "colour": "accent", "x": "menu_x", "y": 60, "height": 2,
          "width": "60 * enter(2)" },

        { "id": "play", "type": "button", "style": "none", "font": "ui_bold", "size": 15, "text_align": "left", "padding": 14,
          "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
          "text": "{translate('menu.singleplayer')}", "x": "menu_x + slide(2) + 6 * hover_t", "y": "menu_y", "width": 220, "height": 26,
          "opacity": "enter(2)", "action": { "type": "open", "screen": "singleplayer" },
          "children": [ { "id": "bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
        { "id": "multiplayer", "type": "button", "style": "none", "font": "ui_bold", "size": 15, "text_align": "left", "padding": 14,
          "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
          "text": "{translate('menu.multiplayer')}", "x": "menu_x + slide(3) + 6 * hover_t", "y": "menu_y + row", "width": 220, "height": 26,
          "opacity": "enter(3)", "action": { "type": "open", "screen": "multiplayer" },
          "children": [ { "id": "bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
        { "id": "mods", "type": "button", "style": "none", "font": "ui_bold", "size": 15, "text_align": "left", "padding": 14,
          "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
          "text": "{translate('fml.menu.mods')}", "x": "menu_x + slide(4) + 6 * hover_t", "y": "menu_y + row * 2", "width": 220, "height": 26,
          "opacity": "enter(4)", "action": { "type": "open", "screen": "mods" },
          "children": [ { "id": "bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
        { "id": "options", "type": "button", "style": "none", "font": "ui_bold", "size": 15, "text_align": "left", "padding": 14,
          "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
          "text": "{translate('menu.options')}", "x": "menu_x + slide(5) + 6 * hover_t", "y": "menu_y + row * 3", "width": 220, "height": 26,
          "opacity": "enter(5)", "action": { "type": "open", "screen": "options" },
          "children": [ { "id": "bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
        { "id": "quit", "type": "button", "style": "none", "font": "ui_bold", "size": 15, "text_align": "left", "padding": 14,
          "text_colour": "#B0FFFFFF", "hover_text_colour": "#FF8A80", "shadow": false,
          "text": "{translate('menu.quit')}", "x": "menu_x + slide(6) + 6 * hover_t", "y": "menu_y + row * 4 + 14", "width": 220, "height": 26,
          "opacity": "enter(6)", "action": "quit",
          "children": [ { "id": "bar", "type": "rect", "colour": "#FF8A80", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.25 + 0.75 * parent_hover_t" } ] },

        { "id": "small_language", "type": "button", "style": "flat", "radius": 3, "colour": "#40FFFFFF", "hover_colour": "#80FFFFFF",
          "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
          "text": "{translate('options.language')}", "x": "menu_x", "y": "menu_y + row * 5 + 26", "width": 96, "height": 20,
          "opacity": "enter(7)", "action": { "type": "open", "screen": "language" } },
        { "id": "small_packs", "type": "button", "style": "flat", "radius": 3, "colour": "#40FFFFFF", "hover_colour": "#80FFFFFF",
          "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
          "text": "{translate('options.resourcepack')}", "x": "menu_x + 104", "y": "menu_y + row * 5 + 26", "width": 116, "height": 20,
          "opacity": "enter(8)", "action": { "type": "open", "screen": "resource_packs" } }
        ] },

        { "id": "clock", "type": "text", "font": "ui_bold", "size": 28, "shadow": false, "colour": "#FFFFFF", "align": "right",
          "text": "{clock()}", "anchor": "bottom_right", "x": -32, "y": -60, "opacity": "enter(3)" },
        { "id": "date", "type": "text", "font": "ui", "size": 11, "shadow": false, "colour": "#B0FFFFFF", "align": "right",
          "text": "{long_date()}", "anchor": "bottom_right", "x": -32, "y": -44, "opacity": "enter(4)" },
        { "id": "branding", "type": "text", "font": "ui", "size": 8, "shadow": false, "colour": "#80FFFFFF",
          "text": "{branding()}", "anchor": "bottom_left", "x": 8, "y": -6 },

        { "id": "mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "end",
          "anchor": "top_right", "x": -16, "y": 16, "width": 200, "height": 140 }
      ]
    },

    "options": {
      "elements": [
        { "id": "options_background", "type": "include", "screen": "main", "ids": ["panorama", "shade_left", "shade_bottom"],
          "visible": "!in_world" },
        { "id": "world_dim", "type": "rect", "colour": "#C8060A10", "visible": "in_world" },

        { "id": "options_menu", "type": "group", "anchor": "left", "width": 300, "height": 300, "children": [
          { "id": "options_title", "type": "text", "font": "ui_bold", "size": 30, "colour": "#FFFFFF", "shadow": false,
            "text": "{translate('options.title')}", "x": "menu_x + slide(0)", "y": 0, "opacity": "enter(0)" },
          { "id": "options_subtitle", "type": "text", "font": "ui", "size": 11, "colour": "#B0FFFFFF", "shadow": false,
            "text": "{in_world ? translate('menu.game') : 'Minecraft ' + mc_version}", "x": "menu_x + slide(1)", "y": 36, "opacity": "enter(1)" },
          { "id": "options_rule", "type": "rect", "colour": "accent", "x": "menu_x", "y": 54, "height": 2, "width": "60 * enter(1)" },

          { "id": "cat_video", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('options.video')}", "x": "menu_x + slide(2) + 6 * hover_t", "y": 70, "width": 220, "height": 22,
            "opacity": "enter(2)", "action": { "type": "open", "screen": "video" },
            "children": [ { "id": "cat_video_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "cat_controls", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('options.controls')}", "x": "menu_x + slide(2) + 6 * hover_t", "y": 96, "width": 220, "height": 22,
            "opacity": "enter(2)", "action": { "type": "open", "screen": "controls" },
            "children": [ { "id": "cat_controls_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "cat_sounds", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('options.sounds')}", "x": "menu_x + slide(3) + 6 * hover_t", "y": 122, "width": 220, "height": 22,
            "opacity": "enter(3)", "action": { "type": "open", "screen": "sounds" },
            "children": [ { "id": "cat_sounds_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "cat_language", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('options.language')}", "x": "menu_x + slide(3) + 6 * hover_t", "y": 148, "width": 220, "height": 22,
            "opacity": "enter(3)", "action": { "type": "open", "screen": "language" },
            "children": [ { "id": "cat_language_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "cat_packs", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('options.resourcepack')}", "x": "menu_x + slide(4) + 6 * hover_t", "y": 174, "width": 220, "height": 22,
            "opacity": "enter(4)", "action": { "type": "open", "screen": "resource_packs" },
            "children": [ { "id": "cat_packs_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "cat_skin", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('options.skinCustomisation')}", "x": "menu_x + slide(4) + 6 * hover_t", "y": 200, "width": 220, "height": 22,
            "opacity": "enter(4)", "action": { "type": "open", "screen": "skin" },
            "children": [ { "id": "cat_skin_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "cat_chat", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('options.chat.title')}", "x": "menu_x + slide(5) + 6 * hover_t", "y": 226, "width": 220, "height": 22,
            "opacity": "enter(5)", "action": { "type": "open", "screen": "chat" },
            "children": [ { "id": "cat_chat_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },

          { "id": "options_done", "type": "button", "style": "flat", "radius": 3, "colour": "accent", "hover_colour": "brighten(accent, 0.25)",
            "font": "ui_bold", "size": 11, "shadow": false, "text_colour": "#FF06121A", "hover_text_colour": "#FF06121A",
            "text": "{translate('gui.done')}", "x": "menu_x", "y": 266, "width": 104, "height": 22,
            "opacity": "enter(6)", "action": "back" },
          { "id": "options_classic", "type": "button", "style": "flat", "radius": 3, "colour": "#40FFFFFF", "hover_colour": "#80FFFFFF",
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "Classic options", "tooltip": "Open Minecraft's own options screen", "x": "menu_x + 112", "y": 266, "width": 108, "height": 22,
            "opacity": "enter(6)", "action": "classic_options" }
        ] },

        { "id": "quick_panel", "type": "rect", "anchor": "right", "x": -36, "width": 260, "height": "foreign_buttons > 0 ? 300 : 204", "radius": 6,
          "colour": "#B0080C12", "border_colour": "#20FFFFFF", "opacity": "enter(3)", "children": [
          { "id": "quick_label", "type": "text", "x": 16, "y": 14, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false,
            "text": "QUICK SETTINGS" },
          { "id": "fov", "type": "slider", "option": "FOV", "x": 16, "y": 32, "width": "pw - 32", "height": 20,
            "font": "ui", "size": 10, "shadow": false, "fill_colour": "with_alpha(accent, 0.55)", "knob_colour": "accent" },
          { "id": "render_distance", "type": "slider", "option": "RENDER_DISTANCE", "x": 16, "y": 58, "width": "pw - 32", "height": 20,
            "font": "ui", "size": 10, "shadow": false, "fill_colour": "with_alpha(accent, 0.55)", "knob_colour": "accent" },
          { "id": "volume_master", "type": "slider", "option": "sound:master", "x": 16, "y": 84, "width": "pw - 32", "height": 20,
            "font": "ui", "size": 10, "shadow": false, "fill_colour": "with_alpha(accent, 0.55)", "knob_colour": "accent" },
          { "id": "volume_music", "type": "slider", "option": "sound:music", "x": 16, "y": 110, "width": "pw - 32", "height": 20,
            "font": "ui", "size": 10, "shadow": false, "fill_colour": "with_alpha(accent, 0.55)", "knob_colour": "accent" },

          { "id": "gui_scale", "type": "button", "style": "flat", "radius": 3, "colour": "#30FFFFFF", "hover_colour": "#60FFFFFF",
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{option_text('GUI_SCALE')}", "x": 16, "y": 140, "width": "(pw - 40) / 2", "height": 20,
            "action": { "type": "option", "name": "GUI_SCALE" } },
          { "id": "fullscreen", "type": "button", "style": "flat", "radius": 3, "colour": "#30FFFFFF", "hover_colour": "#60FFFFFF",
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{option_text('USE_FULLSCREEN')}", "x": "24 + (pw - 40) / 2", "y": 140, "width": "(pw - 40) / 2", "height": 20,
            "action": { "type": "option", "name": "USE_FULLSCREEN" } },
          { "id": "view_bobbing", "type": "button", "style": "flat", "radius": 3, "colour": "#30FFFFFF", "hover_colour": "#60FFFFFF",
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{option_text('VIEW_BOBBING')}", "x": 16, "y": 166, "width": "(pw - 40) / 2", "height": 20,
            "action": { "type": "option", "name": "VIEW_BOBBING" } },
          { "id": "difficulty", "type": "button", "style": "flat", "radius": 3, "colour": "#30FFFFFF", "hover_colour": "#60FFFFFF",
            "disabled_colour": "#18FFFFFF", "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{difficulty_text()}", "x": "24 + (pw - 40) / 2", "y": 166, "width": "(pw - 40) / 2", "height": 20,
            "visible": "in_world", "enabled": "can_change_difficulty()",
            "tooltip": "{can_change_difficulty() ? '' : 'Only the host of a world can change it, and not once it is locked'}",
            "action": "difficulty" },
          { "id": "auto_jump", "type": "button", "style": "flat", "radius": 3, "colour": "#30FFFFFF", "hover_colour": "#60FFFFFF",
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{option_text('AUTO_JUMP')}", "x": "24 + (pw - 40) / 2", "y": 166, "width": "(pw - 40) / 2", "height": 20,
            "visible": "!in_world", "action": { "type": "option", "name": "AUTO_JUMP" } },

          { "id": "mods_label", "type": "text", "x": 16, "y": 200, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false,
            "text": "MOD SETTINGS", "visible": "foreign_buttons > 0" },
          { "id": "options_mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "start",
            "x": 16, "y": 214, "width": "pw - 32", "height": 80 }
        ] }
      ]
    },

    "pause": {
      "elements": [
        { "id": "pause_dim", "type": "rect", "colour": "#60060A10" },
        { "id": "pause_shade", "type": "include", "screen": "main", "ids": ["shade_left"] },
        { "id": "pause_clock", "type": "include", "screen": "main", "ids": ["clock", "date"] },

        { "id": "pause_menu", "type": "group", "anchor": "left", "width": 300, "height": 292, "children": [
          { "id": "pause_title", "type": "text", "font": "ui_bold", "size": 30, "colour": "#FFFFFF", "shadow": false,
            "text": "{translate('menu.game')}", "x": "menu_x + slide(0)", "y": 0, "opacity": "enter(0)" },
          { "id": "pause_subtitle", "type": "text", "font": "ui", "size": 11, "colour": "#B0FFFFFF", "shadow": false,
            "text": "{is_empty(pack_name) ? 'Minecraft ' + mc_version : pack_name}{lan_open ? '  /  LAN' : ''}", "x": "menu_x + slide(1)", "y": 36, "opacity": "enter(1)" },
          { "id": "pause_rule", "type": "rect", "colour": "accent", "x": "menu_x", "y": 54, "height": 2, "width": "60 * enter(1)" },

          { "id": "resume", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('menu.returnToGame')}", "x": "menu_x + slide(2) + 6 * hover_t", "y": 70, "width": 220, "height": 22,
            "opacity": "enter(2)", "action": "resume",
            "children": [ { "id": "resume_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "pause_options", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('menu.options')}", "x": "menu_x + slide(2) + 6 * hover_t", "y": 96, "width": 220, "height": 22,
            "opacity": "enter(2)", "action": { "type": "open", "screen": "options" },
            "children": [ { "id": "pause_options_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "advancements", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('gui.advancements')}", "x": "menu_x + slide(3) + 6 * hover_t", "y": 122, "width": 220, "height": 22,
            "opacity": "enter(3)", "action": { "type": "open", "screen": "advancements" },
            "children": [ { "id": "advancements_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "statistics", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('gui.stats')}", "x": "menu_x + slide(3) + 6 * hover_t", "y": 148, "width": 220, "height": 22,
            "opacity": "enter(3)", "action": { "type": "open", "screen": "statistics" },
            "children": [ { "id": "statistics_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "mod_options", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
            "text": "{translate('fml.menu.modoptions')}", "x": "menu_x + slide(4) + 6 * hover_t", "y": 174, "width": 220, "height": 22,
            "opacity": "enter(4)", "action": { "type": "open", "screen": "mod_options" },
            "children": [ { "id": "mod_options_bar", "type": "rect", "colour": "accent", "width": "2 + 2 * parent_hover_t", "height": "100%", "opacity": "0.35 + 0.65 * parent_hover_t" } ] },
          { "id": "lan", "type": "button", "style": "none", "font": "ui_bold", "size": 13, "text_align": "left", "padding": 12,
            "text_colour": "#F0FFFFFF", "hover_text_colour": "accent", "shadow": false,
