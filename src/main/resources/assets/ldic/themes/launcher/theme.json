{
  "_comment": "LDIC built-in menu theme 'launcher': a game-launcher layout. Top bar with the pack name and secondary buttons, a large Play button, and optional cards for a featured server (live status) and news (a text file on the web). Set server_address / server_name / news_url in 'constants' to turn the cards on.",
  "ldic": 1,
  "forge_update_notice": false,
  "name": "Launcher",
  "author": "Mica Technologies",
  "description": "Top bar, big Play button, live server card and news card.",
  "design": { "mode": "height", "height": 420, "min": 0.5 },
  "fonts": { "ui": "sans", "ui_bold": "sans:bold" },
  "constants": {
    "accent": "#7C4DFF",
    "server_address": "''",
    "server_name": "'Featured server'",
    "news_url": "''"
  },
  "functions": {
    "enter(number i)": "reduced_motion ? 1 : ease_out_cubic(saturate((screen_time - 0.05 * i) / 0.4))"
  },
  "screens": {
    "main": {
      "elements": [
        { "id": "backdrop", "type": "rect", "colour": "#0B0D12" },
        { "id": "art", "type": "image", "fit": "cover", "duration": 14, "fade": 2, "ken_burns": "reduced_motion ? 0 : 0.06",
          "images": [
            "minecraft:textures/gui/title/background/panorama_0.png",
            "minecraft:textures/gui/title/background/panorama_1.png",
            "minecraft:textures/gui/title/background/panorama_2.png",
            "minecraft:textures/gui/title/background/panorama_3.png"
          ] },
        { "id": "shade", "type": "rect", "gradient": "horizontal", "colour": "#F00B0D12", "colour_bottom": "#400B0D12" },

        { "id": "top_bar", "type": "rect", "height": 34, "colour": "#E0080A0F", "children": [
          { "id": "brand_mark", "type": "rect", "anchor": "left", "x": 16, "width": 4, "height": 16, "colour": "accent" },
          { "id": "brand", "type": "text", "anchor": "left", "x": 26, "font": "ui_bold", "size": 13, "shadow": false,
            "text": "{upper(is_empty(pack_name) ? 'Minecraft' : pack_name)}" },
          { "id": "top_quit", "type": "button", "style": "none", "anchor": "right", "x": -12, "width": 54, "height": 34,
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "#FF8A80",
            "text": "{translate('menu.quit')}", "action": "quit" },
          { "id": "top_options", "type": "button", "style": "none", "anchor": "right", "x": -72, "width": 70, "height": 34,
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{translate('menu.options')}", "action": { "type": "open", "screen": "options" },
            "children": [ { "id": "underline", "type": "rect", "anchor": "bottom", "y": -6, "height": 2, "width": "40 * parent_hover_t", "colour": "accent" } ] },
          { "id": "top_mods", "type": "button", "style": "none", "anchor": "right", "x": -146, "width": 56, "height": 34,
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{translate('fml.menu.mods')}", "action": { "type": "open", "screen": "mods" },
            "children": [ { "id": "underline", "type": "rect", "anchor": "bottom", "y": -6, "height": 2, "width": "30 * parent_hover_t", "colour": "accent" } ] },
          { "id": "top_language", "type": "button", "style": "none", "anchor": "right", "x": -206, "width": 70, "height": 34,
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{translate('options.language')}", "action": { "type": "open", "screen": "language" },
            "children": [ { "id": "underline", "type": "rect", "anchor": "bottom", "y": -6, "height": 2, "width": "40 * parent_hover_t", "colour": "accent" } ] }
        ] },

        { "id": "hero", "type": "group", "anchor": "left", "x": 40, "y": 10, "width": 300, "height": 200, "children": [
          { "id": "welcome", "type": "text", "font": "ui", "size": 11, "colour": "#90FFFFFF", "shadow": false,
            "text": "Welcome back, {username}", "opacity": "enter(0)" },
          { "id": "headline", "type": "text", "y": 16, "font": "ui_bold", "size": 30, "colour": "#FFFFFF", "shadow": false,
            "text": "{is_empty(pack_name) ? 'Minecraft' : pack_name}", "opacity": "enter(1)", "x": "-12 * (1 - enter(1))" },
          { "id": "play", "type": "button", "style": "flat", "x": 85, "y": 88, "width": 170, "height": 36, "radius": 4,
            "colour": "accent", "hover_colour": "brighten(accent, 0.2)", "pressed_colour": "darken(accent, 0.15)",
            "font": "ui_bold", "size": 14, "shadow": false, "text_colour": "#FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{upper(translate('menu.singleplayer'))}", "opacity": "enter(2)", "scale": "1 + 0.03 * hover_t",
            "pivot": "center", "action": { "type": "open", "screen": "singleplayer" } },
          { "id": "multiplayer", "type": "button", "style": "flat", "y": 114, "width": 170, "height": 28, "radius": 4,
            "colour": "#30FFFFFF", "hover_colour": "#50FFFFFF", "border_colour": "#40FFFFFF",
            "font": "ui", "size": 11, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{translate('menu.multiplayer')}", "opacity": "enter(3)", "action": { "type": "open", "screen": "multiplayer" } }
        ] },

        { "id": "server_card", "type": "rect", "anchor": "top_right", "x": -24, "y": 56, "width": 220, "height": 92, "radius": 6,
          "colour": "#C0101420", "border_colour": "#30FFFFFF", "visible": "!is_empty(server_address)", "opacity": "enter(4)",
          "children": [
            { "id": "server_label", "type": "text", "x": 14, "y": 12, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false, "text": "FEATURED SERVER" },
            { "id": "server_title", "type": "text", "x": 14, "y": 26, "font": "ui_bold", "size": 13, "colour": "#FFFFFF", "shadow": false, "text": "{server_name}" },
            { "id": "server_dot", "type": "rect", "x": 14, "y": 49, "width": 7, "height": 7, "radius": 3.5,
              "colour": "server_online(server_address) ? #66BB6A : #EF5350" },
            { "id": "server_state", "type": "text", "x": 26, "y": 48, "font": "ui", "size": 9, "colour": "#C0FFFFFF", "shadow": false,
              "text": "{server_online(server_address) ? server_players(server_address) + ' / ' + server_max_players(server_address) + ' online  ·  ' + server_ping(server_address) + ' ms' : 'Offline or unreachable'}" },
            { "id": "server_join", "type": "button", "style": "flat", "anchor": "bottom_right", "x": -12, "y": -10, "width": 64, "height": 20, "radius": 3,
              "colour": "accent", "hover_colour": "brighten(accent, 0.2)", "font": "ui_bold", "size": 10, "shadow": false,
              "text_colour": "#FFFFFF", "hover_text_colour": "#FFFFFF", "text": "Join",
              "action": { "type": "connect", "address": "{server_address}", "name": "{server_name}" } }
          ] },

        { "id": "news_card", "type": "rect", "anchor": "top_right", "x": -24, "y": 160, "width": 220, "height": 70, "radius": 6,
          "colour": "#C0101420", "border_colour": "#30FFFFFF", "visible": "!is_empty(news_url) && web_line_count(news_url) > 0",
          "opacity": "enter(5)", "children": [
            { "id": "news_label", "type": "text", "x": 14, "y": 12, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false, "text": "NEWS" },
            { "id": "news_line", "type": "text", "x": 14, "y": 28, "width": 192, "wrap": true, "font": "ui", "size": 10, "colour": "#E0FFFFFF",
              "shadow": false, "line_spacing": 1.2, "text": "{web_line(news_url, floor(time / 8))}", "opacity": "triangle(time, 8) * 4" }
          ] },

        { "id": "footer", "type": "rect", "anchor": "bottom", "height": 22, "colour": "#A0080A0F", "children": [
          { "id": "version", "type": "text", "anchor": "left", "x": 16, "font": "ui", "size": 9, "colour": "#70FFFFFF", "shadow": false,
            "text": "Minecraft {mc_version}  ·  Forge {forge_version}  ·  {mod_count} mods" },
          { "id": "clock", "type": "text", "anchor": "right", "align": "right", "x": -16, "font": "ui", "size": 9, "colour": "#B0FFFFFF", "shadow": false,
            "text": "{clock()}" }
        ] },

        { "id": "mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "end",
          "anchor": "bottom_right", "x": -24, "y": -32, "width": 200, "height": 120 }
      ]
    },

    "options": {
      "elements": [
        { "id": "options_background", "type": "include", "screen": "main", "ids": ["backdrop", "art", "shade"], "visible": "!in_world" },
        { "id": "world_dim", "type": "rect", "colour": "#C80B0D12", "visible": "in_world" },

        { "id": "options_bar", "type": "rect", "height": 34, "colour": "#E0080A0F", "children": [
          { "id": "options_mark", "type": "rect", "anchor": "left", "x": 16, "width": 4, "height": 16, "colour": "accent" },
          { "id": "options_title", "type": "text", "anchor": "left", "x": 26, "font": "ui_bold", "size": 13, "shadow": false,
            "text": "{upper(translate('options.title'))}" },
          { "id": "options_back", "type": "button", "style": "none", "anchor": "right", "x": -12, "width": 70, "height": 34,
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{translate('gui.done')}", "action": "back",
            "children": [ { "id": "underline", "type": "rect", "anchor": "bottom", "height": 2, "width": "pw * parent_hover_t", "colour": "accent" } ] },
          { "id": "options_classic", "type": "button", "style": "none", "anchor": "right", "x": -86, "width": 110, "height": 34,
            "font": "ui", "size": 10, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "Classic options", "tooltip": "Open Minecraft's own options screen", "action": "classic_options",
            "children": [ { "id": "underline", "type": "rect", "anchor": "bottom", "height": 2, "width": "pw * parent_hover_t", "colour": "accent" } ] }
        ] },

        { "id": "options_body", "type": "group", "anchor": "center", "y": 17, "width": 560, "height": 320, "opacity": "enter(1)", "children": [
          { "id": "categories", "type": "rect", "width": 250, "height": 320, "radius": 6, "colour": "#D0101319", "border_colour": "#18FFFFFF", "children": [
            { "id": "categories_label", "type": "text", "x": 16, "y": 14, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false, "text": "SETTINGS" },
            { "id": "cat_video", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
              "font": "ui_bold", "size": 11, "shadow": false, "text_align": "left", "padding": 12, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{translate('options.video')}", "x": 16, "y": 32, "width": "pw - 32", "height": 30, "action": { "type": "open", "screen": "video" } },
            { "id": "cat_controls", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
              "font": "ui_bold", "size": 11, "shadow": false, "text_align": "left", "padding": 12, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{translate('options.controls')}", "x": 16, "y": 66, "width": "pw - 32", "height": 30, "action": { "type": "open", "screen": "controls" } },
            { "id": "cat_sounds", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
              "font": "ui_bold", "size": 11, "shadow": false, "text_align": "left", "padding": 12, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{translate('options.sounds')}", "x": 16, "y": 100, "width": "pw - 32", "height": 30, "action": { "type": "open", "screen": "sounds" } },
            { "id": "cat_language", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
              "font": "ui_bold", "size": 11, "shadow": false, "text_align": "left", "padding": 12, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{translate('options.language')}", "x": 16, "y": 134, "width": "pw - 32", "height": 30, "action": { "type": "open", "screen": "language" } },
            { "id": "cat_packs", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
              "font": "ui_bold", "size": 11, "shadow": false, "text_align": "left", "padding": 12, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{translate('options.resourcepack')}", "x": 16, "y": 168, "width": "pw - 32", "height": 30, "action": { "type": "open", "screen": "resource_packs" } },
            { "id": "cat_skin", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
              "font": "ui_bold", "size": 11, "shadow": false, "text_align": "left", "padding": 12, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{translate('options.skinCustomisation')}", "x": 16, "y": 202, "width": "pw - 32", "height": 30, "action": { "type": "open", "screen": "skin" } },
            { "id": "cat_chat", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
              "font": "ui_bold", "size": 11, "shadow": false, "text_align": "left", "padding": 12, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{translate('options.chat.title')}", "x": 16, "y": 236, "width": "pw - 32", "height": 30, "action": { "type": "open", "screen": "chat" } },
            { "id": "cat_snooper", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
              "font": "ui_bold", "size": 11, "shadow": false, "text_align": "left", "padding": 12, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{translate('options.snooper.view')}", "x": 16, "y": 270, "width": "pw - 32", "height": 30, "action": { "type": "open", "screen": "snooper" } }
          ] },

          { "id": "quick", "type": "rect", "x": 262, "width": 298, "height": 320, "radius": 6, "colour": "#D0101319", "border_colour": "#18FFFFFF", "children": [
            { "id": "quick_label", "type": "text", "x": 16, "y": 14, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false, "text": "QUICK SETTINGS" },
            { "id": "fov", "type": "slider", "option": "FOV", "x": 16, "y": 32, "width": "pw - 32", "height": 22, "radius": 4,
              "font": "ui", "size": 10, "shadow": false, "fill_colour": "with_alpha(accent, 0.6)", "knob_colour": "#FFFFFF" },
            { "id": "render_distance", "type": "slider", "option": "RENDER_DISTANCE", "x": 16, "y": 60, "width": "pw - 32", "height": 22, "radius": 4,
              "font": "ui", "size": 10, "shadow": false, "fill_colour": "with_alpha(accent, 0.6)", "knob_colour": "#FFFFFF" },
            { "id": "volume_master", "type": "slider", "option": "sound:master", "x": 16, "y": 88, "width": "pw - 32", "height": 22, "radius": 4,
              "font": "ui", "size": 10, "shadow": false, "fill_colour": "with_alpha(accent, 0.6)", "knob_colour": "#FFFFFF" },
            { "id": "volume_music", "type": "slider", "option": "sound:music", "x": 16, "y": 116, "width": "pw - 32", "height": 22, "radius": 4,
              "font": "ui", "size": 10, "shadow": false, "fill_colour": "with_alpha(accent, 0.6)", "knob_colour": "#FFFFFF" },
            { "id": "gui_scale", "type": "button", "style": "flat", "radius": 4, "colour": "#20FFFFFF", "hover_colour": "#40FFFFFF",
              "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{option_text('GUI_SCALE')}", "x": 16, "y": 148, "width": "(pw - 40) / 2", "height": 22,
              "action": { "type": "option", "name": "GUI_SCALE" } },
            { "id": "fullscreen", "type": "button", "style": "flat", "radius": 4, "colour": "#20FFFFFF", "hover_colour": "#40FFFFFF",
              "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{option_text('USE_FULLSCREEN')}", "x": "24 + (pw - 40) / 2", "y": 148, "width": "(pw - 40) / 2", "height": 22,
              "action": { "type": "option", "name": "USE_FULLSCREEN" } },
            { "id": "graphics", "type": "button", "style": "flat", "radius": 4, "colour": "#20FFFFFF", "hover_colour": "#40FFFFFF",
              "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{option_text('GRAPHICS')}", "x": 16, "y": 176, "width": "(pw - 40) / 2", "height": 22,
              "action": { "type": "option", "name": "GRAPHICS" } },
            { "id": "difficulty", "type": "button", "style": "flat", "radius": 4, "colour": "#20FFFFFF", "hover_colour": "#40FFFFFF",
              "disabled_colour": "#10FFFFFF", "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{difficulty_text()}", "x": "24 + (pw - 40) / 2", "y": 176, "width": "(pw - 40) / 2", "height": 22,
              "visible": "in_world", "enabled": "can_change_difficulty()", "action": "difficulty" },
            { "id": "vsync", "type": "button", "style": "flat", "radius": 4, "colour": "#20FFFFFF", "hover_colour": "#40FFFFFF",
              "font": "ui", "size": 10, "shadow": false, "text_colour": "#E0FFFFFF", "hover_text_colour": "#FFFFFF",
              "text": "{option_text('ENABLE_VSYNC')}", "x": "24 + (pw - 40) / 2", "y": 176, "width": "(pw - 40) / 2", "height": 22,
              "visible": "!in_world", "action": { "type": "option", "name": "ENABLE_VSYNC" } },
            { "id": "mods_label", "type": "text", "x": 16, "y": 212, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false,
              "text": "MOD SETTINGS", "visible": "foreign_buttons > 0" },
            { "id": "options_mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "start",
              "x": 16, "y": 226, "width": "pw - 32", "height": 84 }
          ] }
        ] }
      ]
    },

    "pause": {
      "elements": [
        { "id": "pause_dim", "type": "rect", "colour": "#900B0D12" },

        { "id": "pause_bar", "type": "rect", "height": 34, "colour": "#E0080A0F", "children": [
          { "id": "pause_mark", "type": "rect", "anchor": "left", "x": 16, "width": 4, "height": 16, "colour": "accent" },
          { "id": "pause_title", "type": "text", "anchor": "left", "x": 26, "font": "ui_bold", "size": 13, "shadow": false,
            "text": "{upper(is_empty(pack_name) ? translate('menu.game') : pack_name)}" },
          { "id": "pause_clock", "type": "text", "anchor": "right", "align": "right", "x": -16, "font": "ui", "size": 10, "colour": "#B0FFFFFF", "shadow": false,
            "text": "{clock()}" }
        ] },

        { "id": "pause_card", "type": "rect", "anchor": "center", "y": 17, "width": 300, "height": 254, "radius": 6,
          "colour": "#D0101319", "border_colour": "#18FFFFFF", "opacity": "enter(1)", "children": [
          { "id": "resume", "type": "button", "style": "flat", "radius": 4, "colour": "accent", "hover_colour": "brighten(accent, 0.2)",
            "font": "ui_bold", "size": 14, "shadow": false, "text_colour": "#FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{upper(translate('menu.returnToGame'))}", "x": 16, "y": 16, "width": "pw - 32", "height": 40, "action": "resume" },
          { "id": "pause_options", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
            "font": "ui_bold", "size": 11, "shadow": false, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{translate('menu.options')}", "x": 16, "y": 66, "width": "(pw - 40) / 2", "height": 30, "action": { "type": "open", "screen": "options" } },
          { "id": "mod_options", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
            "font": "ui_bold", "size": 11, "shadow": false, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{translate('fml.menu.modoptions')}", "x": "24 + (pw - 40) / 2", "y": 66, "width": "(pw - 40) / 2", "height": 30, "action": { "type": "open", "screen": "mod_options" } },
          { "id": "advancements", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
            "font": "ui_bold", "size": 11, "shadow": false, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{translate('gui.advancements')}", "x": 16, "y": 102, "width": "(pw - 40) / 2", "height": 30, "action": { "type": "open", "screen": "advancements" } },
          { "id": "statistics", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
            "font": "ui_bold", "size": 11, "shadow": false, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF",
            "text": "{translate('gui.stats')}", "x": "24 + (pw - 40) / 2", "y": 102, "width": "(pw - 40) / 2", "height": 30, "action": { "type": "open", "screen": "statistics" } },
          { "id": "lan", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "with_alpha(accent, 0.45)",
            "font": "ui_bold", "size": 11, "shadow": false, "text_colour": "#E8FFFFFF", "hover_text_colour": "#FFFFFF", "disabled_colour": "#08FFFFFF", "disabled_text_colour": "#60FFFFFF",
            "text": "{lan_open ? 'LAN world open' : translate('menu.shareToLan')}", "x": 16, "y": 138, "width": "pw - 32", "height": 30,
            "enabled": "singleplayer && !lan_open", "action": { "type": "open", "screen": "lan" } },
          { "id": "leave", "type": "button", "style": "flat", "radius": 4, "colour": "#14FFFFFF", "hover_colour": "#C0E53935",
            "font": "ui_bold", "size": 11, "shadow": false, "text_colour": "#FF8A80", "hover_text_colour": "#FFFFFF",
            "text": "{translate(singleplayer ? 'menu.returnToMenu' : 'menu.disconnect')}", "x": 16, "y": 182, "width": "pw - 32", "height": 30,
            "action": "disconnect" },
          { "id": "pause_hint", "type": "text", "anchor": "bottom", "align": "center", "y": -12, "font": "ui", "size": 8, "colour": "#60FFFFFF", "shadow": false,
            "text": "{in_world && singleplayer ? 'Game paused' : ''}" }
        ] },

        { "id": "pause_mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "end",
          "anchor": "top_right", "x": -16, "y": 46, "width": 200, "height": 120 }
      ]
    }
  }
}
