{
  "_comment": "LDIC built-in menu theme 'premiere': cinematic. Scenes slowly pan and crossfade in letterbox; the title sits in the top bar and the menu is a single row in the bottom bar. Override the 'scenes' element's images with screenshots of your world.",
  "ldic": 1,
  "forge_update_notice": false,
  "name": "Premiere",
  "author": "Mica Technologies",
  "description": "Letterboxed, slowly panning scenes with a single-row menu.",
  "design": { "mode": "height", "height": 360, "min": 0.5 },
  "fonts": { "ui": "sans", "ui_bold": "sans:bold" },
  "constants": {
    "accent": "#E8D8A0",
    "item_w": 104,
    "cat_w": 84
  },
  "variables": {
    "bar_h": "screen_height * 0.13"
  },
  "functions": {
    "reveal(number i)": "reduced_motion ? 1 : ease_out_cubic(saturate((screen_time - 0.4 - 0.08 * i) / 0.6))"
  },
  "screens": {
    "main": {
      "elements": [
        { "id": "backdrop", "type": "rect", "colour": "#000000" },
        { "id": "scenes", "type": "image", "fit": "cover", "duration": 12, "fade": 2.5, "ken_burns": "reduced_motion ? 0 : 0.14",
          "images": [
            "minecraft:textures/gui/title/background/panorama_0.png",
            "minecraft:textures/gui/title/background/panorama_1.png",
            "minecraft:textures/gui/title/background/panorama_2.png",
            "minecraft:textures/gui/title/background/panorama_3.png"
          ] },
        { "id": "grade", "type": "rect", "colour": "#20000000", "colour_bottom": "#60000000" },

        { "id": "bar_top", "type": "rect", "anchor": "top", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "title", "type": "text", "anchor": "center", "align": "center", "font": "ui_bold", "size": 16, "colour": "#FFFFFF", "shadow": false,
            "text": "{upper(is_empty(pack_name) ? 'Minecraft' : pack_name)}", "opacity": "reveal(0)" },
          { "id": "clock", "type": "text", "anchor": "right", "align": "right", "x": -20, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false,
            "text": "{clock()}" }
        ] },

        { "id": "bar_bottom", "type": "rect", "anchor": "bottom", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "menu", "type": "group", "anchor": "center", "width": "item_w * 5", "height": 24, "children": [
            { "id": "play", "type": "button", "style": "none", "x": "item_w * 0", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('menu.singleplayer'))}", "opacity": "reveal(1)", "action": { "type": "open", "screen": "singleplayer" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "multiplayer", "type": "button", "style": "none", "x": "item_w * 1", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('menu.multiplayer'))}", "opacity": "reveal(2)", "action": { "type": "open", "screen": "multiplayer" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "mods", "type": "button", "style": "none", "x": "item_w * 2", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('fml.menu.mods'))}", "opacity": "reveal(3)", "action": { "type": "open", "screen": "mods" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "options", "type": "button", "style": "none", "x": "item_w * 3", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('menu.options'))}", "opacity": "reveal(4)", "action": { "type": "open", "screen": "options" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "quit", "type": "button", "style": "none", "x": "item_w * 4", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#90FFFFFF", "hover_text_colour": "#FF8A80",
              "text": "{upper(translate('menu.quit'))}", "opacity": "reveal(5)", "action": "quit",
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "#FF8A80" } ] }
          ] },
          { "id": "branding", "type": "text", "anchor": "bottom_left", "x": 12, "y": -4, "font": "ui", "size": 7, "colour": "#50FFFFFF", "shadow": false,
            "text": "Minecraft {mc_version}  ·  {mod_count} mods" }
        ] },

        { "id": "mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "start",
          "anchor": "top_right", "x": -12, "y": "bar_h + 12", "width": 200, "height": 140 }
      ]
    },

    "options": {
      "elements": [
        { "id": "options_background", "type": "include", "screen": "main", "ids": ["backdrop", "scenes", "grade"], "visible": "!in_world" },
        { "id": "world_dim", "type": "rect", "colour": "#B0000000", "visible": "in_world" },

        { "id": "options_bar_top", "type": "rect", "anchor": "top", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "options_back", "type": "button", "style": "none", "anchor": "left", "x": 12, "width": 90, "height": 24,
            "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "accent",
            "text": "{upper(translate('gui.done'))}", "action": "back",
            "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
          { "id": "options_title", "type": "text", "anchor": "center", "align": "center", "font": "ui_bold", "size": 16, "colour": "#FFFFFF", "shadow": false,
            "text": "{upper(translate('options.title'))}", "opacity": "reveal(0)" },
          { "id": "options_classic", "type": "button", "style": "none", "anchor": "right", "x": -12, "width": 110, "height": 24,
            "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "accent",
            "text": "CLASSIC OPTIONS", "tooltip": "Open Minecraft's own options screen", "action": "classic_options",
            "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] }
        ] },

        { "id": "quick", "type": "rect", "anchor": "center", "width": 300, "height": "foreign_buttons > 0 ? 196 : 138", "radius": 2,
          "colour": "#A0000000", "opacity": "reveal(2)", "children": [
          { "id": "fov", "type": "slider", "option": "FOV", "x": 14, "y": 14, "width": "pw - 28", "height": 18, "radius": 1, "knob_width": 2,
            "font": "ui", "size": 9, "shadow": false, "track_colour": "#30FFFFFF", "fill_colour": "with_alpha(accent, 0.35)", "knob_colour": "accent" },
          { "id": "render_distance", "type": "slider", "option": "RENDER_DISTANCE", "x": 14, "y": 38, "width": "pw - 28", "height": 18, "radius": 1, "knob_width": 2,
            "font": "ui", "size": 9, "shadow": false, "track_colour": "#30FFFFFF", "fill_colour": "with_alpha(accent, 0.35)", "knob_colour": "accent" },
          { "id": "volume_master", "type": "slider", "option": "sound:master", "x": 14, "y": 62, "width": "pw - 28", "height": 18, "radius": 1, "knob_width": 2,
            "font": "ui", "size": 9, "shadow": false, "track_colour": "#30FFFFFF", "fill_colour": "with_alpha(accent, 0.35)", "knob_colour": "accent" },
          { "id": "volume_music", "type": "slider", "option": "sound:music", "x": 14, "y": 86, "width": "pw - 28", "height": 18, "radius": 1, "knob_width": 2,
            "font": "ui", "size": 9, "shadow": false, "track_colour": "#30FFFFFF", "fill_colour": "with_alpha(accent, 0.35)", "knob_colour": "accent" },
          { "id": "gui_scale", "type": "button", "style": "none", "x": 14, "y": 110, "width": "(pw - 28) / 2", "height": 18,
            "font": "ui", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
            "text": "{option_text('GUI_SCALE')}", "action": { "type": "option", "name": "GUI_SCALE" } },
          { "id": "difficulty", "type": "button", "style": "none", "x": "14 + (pw - 28) / 2", "y": 110, "width": "(pw - 28) / 2", "height": 18,
            "font": "ui", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
            "text": "{difficulty_text()}", "visible": "in_world", "enabled": "can_change_difficulty()", "action": "difficulty" },
          { "id": "fullscreen", "type": "button", "style": "none", "x": "14 + (pw - 28) / 2", "y": 110, "width": "(pw - 28) / 2", "height": 18,
            "font": "ui", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
            "text": "{option_text('USE_FULLSCREEN')}", "visible": "!in_world", "action": { "type": "option", "name": "USE_FULLSCREEN" } },
          { "id": "options_mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "center",
            "x": 14, "y": 138, "width": "pw - 28", "height": 50 }
        ] },

        { "id": "options_bar_bottom", "type": "rect", "anchor": "bottom", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "categories", "type": "group", "anchor": "center", "width": "cat_w * 7", "height": 24, "children": [
            { "id": "cat_video", "type": "button", "style": "none", "x": "cat_w * 0", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.video'))}", "opacity": "reveal(3)", "action": { "type": "open", "screen": "video" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_controls", "type": "button", "style": "none", "x": "cat_w * 1", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.controls'))}", "opacity": "reveal(4)", "action": { "type": "open", "screen": "controls" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_sounds", "type": "button", "style": "none", "x": "cat_w * 2", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.sounds'))}", "opacity": "reveal(5)", "action": { "type": "open", "screen": "sounds" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_language", "type": "button", "style": "none", "x": "cat_w * 3", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.language'))}", "opacity": "reveal(6)", "action": { "type": "open", "screen": "language" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_packs", "type": "button", "style": "none", "x": "cat_w * 4", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.resourcepack'))}", "opacity": "reveal(7)", "action": { "type": "open", "screen": "resource_packs" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_skin", "type": "button", "style": "none", "x": "cat_w * 5", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.skinCustomisation'))}", "opacity": "reveal(8)", "action": { "type": "open", "screen": "skin" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_chat", "type": "button", "style": "none", "x": "cat_w * 6", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.chat.title'))}", "opacity": "reveal(9)", "action": { "type": "open", "screen": "chat" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] }
          ] }
        ] }
      ]
    }
  }
}
