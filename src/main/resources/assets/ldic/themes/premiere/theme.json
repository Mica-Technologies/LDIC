{
  "_comment": "LDIC built-in menu theme 'premiere': cinematic. Scenes slowly pan and crossfade in letterbox; the title sits in the top bar and the menu is a single row in the bottom bar. Override the 'scenes' element's images with screenshots of your world.",
  "ldic": 1,
  "forge_update_notice": false,
  "name": "Premiere",
  "author": "Mica Technologies",
  "description": "Letterboxed, slowly panning scenes with a single-row menu.",
  "design": { "mode": "height", "height": 360, "min": 0.5 },
  "fonts": { "ui": "sans", "ui_bold": "sans:bold" },
  "constants": {
    "accent": "#E8D8A0",
    "item_w": 104,
    "cat_w": 84
  },
  "variables": {
    "bar_h": "screen_height * 0.13"
  },
  "functions": {
    "reveal(number i)": "reduced_motion ? 1 : ease_out_cubic(saturate((screen_time - 0.4 - 0.08 * i) / 0.6))"
  },
  "screens": {
    "main": {
      "elements": [
        { "id": "backdrop", "type": "rect", "colour": "#000000" },
        { "id": "scenes", "type": "image", "fit": "cover", "duration": 12, "fade": 2.5, "ken_burns": "reduced_motion ? 0 : 0.14",
          "images": [
            "minecraft:textures/gui/title/background/panorama_0.png",
            "minecraft:textures/gui/title/background/panorama_1.png",
            "minecraft:textures/gui/title/background/panorama_2.png",
            "minecraft:textures/gui/title/background/panorama_3.png"
          ] },
        { "id": "grade", "type": "rect", "colour": "#20000000", "colour_bottom": "#60000000" },

        { "id": "bar_top", "type": "rect", "anchor": "top", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "title", "type": "text", "anchor": "center", "align": "center", "font": "ui_bold", "size": 16, "colour": "#FFFFFF", "shadow": false,
            "text": "{upper(is_empty(pack_name) ? 'Minecraft' : pack_name)}", "opacity": "reveal(0)" },
          { "id": "clock", "type": "text", "anchor": "right", "align": "right", "x": -20, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false,
            "text": "{clock()}" }
        ] },

        { "id": "bar_bottom", "type": "rect", "anchor": "bottom", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "menu", "type": "group", "anchor": "center", "width": "item_w * 5", "height": 24, "children": [
            { "id": "play", "type": "button", "style": "none", "x": "item_w * 0", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('menu.singleplayer'))}", "opacity": "reveal(1)", "action": { "type": "open", "screen": "singleplayer" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "multiplayer", "type": "button", "style": "none", "x": "item_w * 1", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('menu.multiplayer'))}", "opacity": "reveal(2)", "action": { "type": "open", "screen": "multiplayer" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "mods", "type": "button", "style": "none", "x": "item_w * 2", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('fml.menu.mods'))}", "opacity": "reveal(3)", "action": { "type": "open", "screen": "mods" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "options", "type": "button", "style": "none", "x": "item_w * 3", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('menu.options'))}", "opacity": "reveal(4)", "action": { "type": "open", "screen": "options" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "quit", "type": "button", "style": "none", "x": "item_w * 4", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 10, "shadow": false, "text_colour": "#90FFFFFF", "hover_text_colour": "#FF8A80",
              "text": "{upper(translate('menu.quit'))}", "opacity": "reveal(5)", "action": "quit",
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "#FF8A80" } ] }
          ] },
          { "id": "branding", "type": "text", "anchor": "bottom_left", "x": 12, "y": -4, "font": "ui", "size": 7, "colour": "#50FFFFFF", "shadow": false,
            "text": "Minecraft {mc_version}  ·  {mod_count} mods" }
        ] },

        { "id": "mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "start",
          "anchor": "top_right", "x": -12, "y": "bar_h + 12", "width": 200, "height": 140 }
      ]
    },

    "options": {
      "elements": [
        { "id": "options_background", "type": "include", "screen": "main", "ids": ["backdrop", "scenes", "grade"], "visible": "!in_world" },
        { "id": "world_dim", "type": "rect", "colour": "#B0000000", "visible": "in_world" },

        { "id": "options_bar_top", "type": "rect", "anchor": "top", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "options_back", "type": "button", "style": "none", "anchor": "left", "x": 12, "width": 90, "height": 24,
            "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "accent",
            "text": "{upper(translate('gui.done'))}", "action": "back",
            "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
          { "id": "options_title", "type": "text", "anchor": "center", "align": "center", "font": "ui_bold", "size": 16, "colour": "#FFFFFF", "shadow": false,
            "text": "{upper(translate('options.title'))}", "opacity": "reveal(0)" },
          { "id": "options_classic", "type": "button", "style": "none", "anchor": "right", "x": -12, "width": 110, "height": 24,
            "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "accent",
            "text": "CLASSIC OPTIONS", "tooltip": "Open Minecraft's own options screen", "action": "classic_options",
            "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] }
        ] },

        { "id": "quick", "type": "rect", "anchor": "center", "width": 300, "height": "foreign_buttons > 0 ? 196 : 138", "radius": 2,
          "colour": "#A0000000", "opacity": "reveal(2)", "children": [
          { "id": "fov", "type": "slider", "option": "FOV", "x": 14, "y": 14, "width": "pw - 28", "height": 18, "radius": 1, "knob_width": 2,
            "font": "ui", "size": 9, "shadow": false, "track_colour": "#30FFFFFF", "fill_colour": "with_alpha(accent, 0.35)", "knob_colour": "accent" },
          { "id": "render_distance", "type": "slider", "option": "RENDER_DISTANCE", "x": 14, "y": 38, "width": "pw - 28", "height": 18, "radius": 1, "knob_width": 2,
            "font": "ui", "size": 9, "shadow": false, "track_colour": "#30FFFFFF", "fill_colour": "with_alpha(accent, 0.35)", "knob_colour": "accent" },
          { "id": "volume_master", "type": "slider", "option": "sound:master", "x": 14, "y": 62, "width": "pw - 28", "height": 18, "radius": 1, "knob_width": 2,
            "font": "ui", "size": 9, "shadow": false, "track_colour": "#30FFFFFF", "fill_colour": "with_alpha(accent, 0.35)", "knob_colour": "accent" },
          { "id": "volume_music", "type": "slider", "option": "sound:music", "x": 14, "y": 86, "width": "pw - 28", "height": 18, "radius": 1, "knob_width": 2,
            "font": "ui", "size": 9, "shadow": false, "track_colour": "#30FFFFFF", "fill_colour": "with_alpha(accent, 0.35)", "knob_colour": "accent" },
          { "id": "gui_scale", "type": "button", "style": "none", "x": 14, "y": 110, "width": "(pw - 28) / 2", "height": 18,
            "font": "ui", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
            "text": "{option_text('GUI_SCALE')}", "action": { "type": "option", "name": "GUI_SCALE" } },
          { "id": "difficulty", "type": "button", "style": "none", "x": "14 + (pw - 28) / 2", "y": 110, "width": "(pw - 28) / 2", "height": 18,
            "font": "ui", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
            "text": "{difficulty_text()}", "visible": "in_world", "enabled": "can_change_difficulty()", "action": "difficulty" },
          { "id": "fullscreen", "type": "button", "style": "none", "x": "14 + (pw - 28) / 2", "y": 110, "width": "(pw - 28) / 2", "height": 18,
            "font": "ui", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
            "text": "{option_text('USE_FULLSCREEN')}", "visible": "!in_world", "action": { "type": "option", "name": "USE_FULLSCREEN" } },
          { "id": "options_mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "center",
            "x": 14, "y": 138, "width": "pw - 28", "height": 50 }
        ] },

        { "id": "options_bar_bottom", "type": "rect", "anchor": "bottom", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "categories", "type": "group", "anchor": "center", "width": "cat_w * 7", "height": 24, "children": [
            { "id": "cat_video", "type": "button", "style": "none", "x": "cat_w * 0", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.video'))}", "opacity": "reveal(3)", "action": { "type": "open", "screen": "video" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_controls", "type": "button", "style": "none", "x": "cat_w * 1", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.controls'))}", "opacity": "reveal(4)", "action": { "type": "open", "screen": "controls" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_sounds", "type": "button", "style": "none", "x": "cat_w * 2", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.sounds'))}", "opacity": "reveal(5)", "action": { "type": "open", "screen": "sounds" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_language", "type": "button", "style": "none", "x": "cat_w * 3", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.language'))}", "opacity": "reveal(6)", "action": { "type": "open", "screen": "language" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_packs", "type": "button", "style": "none", "x": "cat_w * 4", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.resourcepack'))}", "opacity": "reveal(7)", "action": { "type": "open", "screen": "resource_packs" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_skin", "type": "button", "style": "none", "x": "cat_w * 5", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.skinCustomisation'))}", "opacity": "reveal(8)", "action": { "type": "open", "screen": "skin" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "cat_chat", "type": "button", "style": "none", "x": "cat_w * 6", "width": "cat_w", "height": 24,
              "font": "ui_bold", "size": 8, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('options.chat.title'))}", "opacity": "reveal(9)", "action": { "type": "open", "screen": "chat" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] }
          ] }
        ] }
      ]
    },

    "pause": {
      "elements": [
        { "id": "pause_dim", "type": "rect", "colour": "#50000000" },

        { "id": "pause_bar_top", "type": "rect", "anchor": "top", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "pause_title", "type": "text", "anchor": "center", "align": "center", "font": "ui_bold", "size": 16, "colour": "#FFFFFF", "shadow": false,
            "text": "{upper(is_empty(pack_name) ? translate('menu.game') : pack_name)}", "opacity": "reveal(0)" },
          { "id": "pause_clock", "type": "text", "anchor": "right", "align": "right", "x": -20, "font": "ui", "size": 9, "colour": "#80FFFFFF", "shadow": false,
            "text": "{clock()}" },
          { "id": "lan", "type": "button", "style": "none", "anchor": "left", "x": 12, "width": 110, "height": 24,
            "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "accent",
            "text": "{upper(translate('menu.shareToLan'))}", "visible": "singleplayer && !lan_open", "action": { "type": "open", "screen": "lan" },
            "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
          { "id": "cheats", "type": "button", "style": "none", "anchor": "left", "x": "lan_open ? 12 : 126", "width": 130, "height": 24,
            "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#B0FFFFFF", "hover_text_colour": "accent",
            "text": "{upper(translate('selectWorld.allowCommands') + ' ' + translate(cheats ? 'options.on' : 'options.off'))}",
            "visible": "singleplayer", "action": "cheats",
            "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] }
        ] },

        { "id": "pause_bar_bottom", "type": "rect", "anchor": "bottom", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "pause_row", "type": "group", "anchor": "center", "width": "item_w * 6", "height": 24, "children": [
            { "id": "resume", "type": "button", "style": "none", "x": "item_w * 0", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('menu.returnToGame'))}", "opacity": "reveal(1)", "action": "resume",
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "pause_options", "type": "button", "style": "none", "x": "item_w * 1", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('menu.options'))}", "opacity": "reveal(2)", "action": { "type": "open", "screen": "options" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "advancements", "type": "button", "style": "none", "x": "item_w * 2", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('gui.advancements'))}", "opacity": "reveal(3)", "action": { "type": "open", "screen": "advancements" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "statistics", "type": "button", "style": "none", "x": "item_w * 3", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('gui.stats'))}", "opacity": "reveal(4)", "action": { "type": "open", "screen": "statistics" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "mod_options", "type": "button", "style": "none", "x": "item_w * 4", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "accent",
              "text": "{upper(translate('fml.menu.modoptions'))}", "opacity": "reveal(5)", "action": { "type": "open", "screen": "mod_options" },
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "accent" } ] },
            { "id": "leave", "type": "button", "style": "none", "x": "item_w * 5", "width": "item_w", "height": 24,
              "font": "ui_bold", "size": 9, "shadow": false, "text_colour": "#D0FFFFFF", "hover_text_colour": "#FF8A80",
              "text": "{upper(translate(singleplayer ? 'menu.returnToMenu' : 'menu.disconnect'))}", "opacity": "reveal(6)", "action": "disconnect",
              "tooltip": "{translate(singleplayer ? 'menu.returnToMenu' : 'menu.disconnect')}",
              "children": [ { "id": "line", "type": "rect", "anchor": "bottom", "height": 1, "width": "pw * 0.6 * parent_hover_t", "colour": "#FF8A80" } ] }
          ] }
        ] },

        { "id": "pause_mod_buttons", "type": "foreign_buttons", "layout": "column", "align": "start",
          "anchor": "top_right", "x": -12, "y": "bar_h + 12", "width": 200, "height": 140 }
      ]
    },

    "inventory": {
      "elements": [
        { "id": "inv_panel", "type": "rect", "radius": 0, "colour": "#F2060606", "border_colour": "#40E8D8A0",
          "x": "area_x('panel') - 6", "y": "area_y('panel') - 6", "width": "area_w('panel') + 12", "height": "area_h('panel') + 12" },
        { "id": "inv_rule", "type": "rect", "colour": "accent", "height": 2,
          "x": "area_x('panel') + 0", "y": "area_y('panel') - 6", "width": "56" },
        { "id": "inv_model_box", "type": "rect", "radius": 0, "colour": "#40000000",
          "x": "area_x('panel') + 26", "y": "area_y('panel') + 8", "width": 49, "height": 70 },
        { "id": "inv_model", "type": "player_model",
          "x": "area_x('panel') + 26", "y": "area_y('panel') + 8", "width": 49, "height": 70 },
        { "id": "inv_slots", "type": "slots", "radius": 0, "colour": "#48000000", "border_colour": "#1CFFFFFF",
          "selected_colour": "#30FFFFFF", "selected_border_colour": "accent" },
        { "id": "inv_crafting_label", "type": "text", "font": "ui", "size": 9, "colour": "#B8FFFFFF", "shadow": false,
          "text": "{translate('container.crafting')}", "x": "area_x('crafting')", "y": "area_y('crafting') - 11" },
        { "id": "inv_arrow", "type": "text", "font": "ui_bold", "size": 12, "colour": "accent", "shadow": false, "text": "\u2192",
          "x": "area_x('crafting') + area_w('crafting') + 5", "y": "area_y('result') + 3" }
      ]
    },

    "crafting": {
      "elements": [
        { "id": "craft_frame", "type": "include", "screen": "inventory", "ids": ["inv_panel", "inv_rule", "inv_slots"] },
        { "id": "craft_title", "type": "text", "font": "ui_bold", "size": 9, "colour": "#F0FFFFFF", "shadow": false,
          "text": "{translate('container.crafting')}", "x": "area_x('panel') + 8", "y": "area_y('panel') + 5" },
        { "id": "craft_arrow", "type": "text", "font": "ui_bold", "size": 16, "colour": "accent", "shadow": false, "text": "\u2192",
          "x": "(area_x('crafting') + area_w('crafting') + area_x('result')) / 2 - 7", "y": "area_y('result') + 1" },
        { "id": "craft_inventory_label", "type": "text", "font": "ui", "size": 9, "colour": "#B8FFFFFF", "shadow": false,
          "text": "{translate('container.inventory')}", "x": "area_x('main')", "y": "area_y('main') - 11" }
      ]
    },

    "container": {
      "elements": [
        { "id": "chest_frame", "type": "include", "screen": "inventory", "ids": ["inv_panel", "inv_rule", "inv_slots"] },
        { "id": "chest_title", "type": "text", "font": "ui_bold", "size": 9, "colour": "#F0FFFFFF", "shadow": false,
          "text": "{container_title}", "x": "area_x('container')", "y": "area_y('container') - 11" },
        { "id": "chest_inventory_label", "type": "text", "font": "ui", "size": 9, "colour": "#B8FFFFFF", "shadow": false,
          "text": "{translate('container.inventory')}", "x": "area_x('main')", "y": "area_y('main') - 11" }
      ]
    },

    "creative": {
      "elements": [
        { "id": "cr_top", "type": "rect", "radius": 0, "colour": "#F2060606", "border_colour": "#40E8D8A0",
          "x": "area_x('top')", "y": "area_y('top')", "width": "area_w('top')", "height": "area_h('top')" },
        { "id": "cr_rule", "type": "rect", "colour": "accent", "height": 2,
          "x": "area_x('top') + 0 + 6", "y": "area_y('top')", "width": "56" },
        { "id": "cr_sidebar", "type": "rect", "radius": 0, "colour": "#F2060606", "border_colour": "#40E8D8A0",
          "x": "area_x('sidebar')", "y": "area_y('sidebar')", "width": "area_w('sidebar')", "height": "area_h('sidebar')" },
        { "id": "cr_browser", "type": "rect", "radius": 0, "colour": "#F2060606", "border_colour": "#40E8D8A0",
          "x": "area_x('browser')", "y": "area_y('browser')", "width": "area_w('browser')", "height": "area_h('browser')" },
        { "id": "cr_inventory", "type": "rect", "radius": 0, "colour": "#F2060606", "border_colour": "#40E8D8A0",
          "x": "area_x('inventory')", "y": "area_y('inventory')", "width": "area_w('inventory')", "height": "area_h('inventory')" },
        { "id": "cr_title", "type": "text", "font": "ui_bold", "size": 10, "colour": "#F0FFFFFF", "shadow": false,
          "text": "{translate('selectWorld.gameMode.creative')}",
          "visible": "area_w('sidebar') > 60", "x": "area_x('top') + 7", "y": "area_y('top') + 6" },
        { "id": "cr_inventory_label", "type": "text", "font": "ui", "size": 9, "colour": "#B8FFFFFF", "shadow": false,
          "text": "{translate('container.inventory')}", "x": "area_x('inventory') + 6", "y": "area_y('inventory') + 5" },
        { "id": "cr_model_box", "type": "rect", "radius": 0, "colour": "#40000000",
          "x": "area_x('model')", "y": "area_y('model')", "width": "area_w('model')", "height": "area_h('model')" },
        { "id": "cr_model", "type": "player_model",
          "x": "area_x('model')", "y": "area_y('model')", "width": "area_w('model')", "height": "area_h('model')" },
        { "id": "cr_slots", "type": "slots", "radius": 0, "colour": "#48000000", "border_colour": "#1CFFFFFF",
          "selected_colour": "#30FFFFFF", "selected_border_colour": "accent" }
      ]
    },

    "world_loading": {
      "elements": [
        { "id": "loading_background", "type": "include", "screen": "main", "ids": ["backdrop", "scenes", "grade"] },

        { "id": "loading_bar_top", "type": "rect", "anchor": "top", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "loading_title", "type": "text", "anchor": "center", "align": "center", "font": "ui_bold", "size": 16, "colour": "#FFFFFF", "shadow": false,
            "text": "{upper(is_empty(pack_name) ? 'Minecraft' : pack_name)}" }
        ] },

        { "id": "loading_bar_bottom", "type": "rect", "anchor": "bottom", "height": "bar_h", "colour": "#000000", "children": [
          { "id": "loading_line", "type": "rect", "anchor": "top", "height": 1, "colour": "#30FFFFFF", "children": [
            { "id": "loading_fill", "type": "rect", "anchor": "left", "width": "pw * clamp(status_progress, 0, 1)", "height": 1, "colour": "accent",
              "visible": "status_progress >= 0" },
            { "id": "loading_sweep", "type": "rect", "anchor": "left", "x": "(pw - 120) * (0.5 + 0.5 * sin(time * 120))", "width": 120, "height": 1, "colour": "accent",
              "visible": "status_progress < 0" }
          ] },
          { "id": "loading_headline", "type": "text", "anchor": "center", "align": "center", "y": -6, "font": "ui_bold", "size": 10, "colour": "#FFFFFF", "shadow": false,
            "text": "{upper(status)}", "opacity": "reveal(0)" },
          { "id": "loading_detail", "type": "text", "anchor": "center", "align": "center", "y": 8, "font": "ui", "size": 8, "colour": "#90FFFFFF", "shadow": false,
            "text": "{status_detail}{status_progress >= 0 ? '  ' + round(status_progress * 100) + '%' : ''}", "opacity": "reveal(1)" }
        ] },

        { "id": "loading_buttons", "type": "foreign_buttons", "layout": "column", "align": "center",
          "anchor": "bottom", "y": "-(bar_h + 16)", "width": 200, "height": 24 }
      ]
    }
  }
}
